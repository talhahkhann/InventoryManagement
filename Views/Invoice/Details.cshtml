@model InventoryManagement.Models.Invoice

@{
    ViewData["Title"]       = "Invoice Details";
    ViewData["HeaderIcon"]  = "bi-receipt-cutoff";
    ViewData["HeaderTitle"] = "INVOICE DETAILS";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <div class="inv-confirm-card" style="max-width: 700px; border: 1px solid #cbd5e0;">

        <div class="inv-confirm-icon" style="color: #2c5282;">
            <i class="bi bi-file-earmark-text"></i>
        </div>
        <h2 class="inv-confirm-title" style="color: #2c5282;">Invoice #@Model.Id</h2>
        <p class="inv-confirm-text">Invoice date: @Model.InvoiceDate.ToString("MMM dd, yyyy")</p>

        <div class="inv-confirm-meta">
            <dl>
                <dt>Customer ID</dt>
                <dd>@Model.CustomerId</dd>

                <dt>Customer Name</dt>
                <dd>@(Model.Customer?.Name ?? "Unknown Customer")</dd>

                <dt>Area</dt>
                <dd>@(Model.Customer?.Area?.AreaName ?? "N/A")</dd>

                <dt>Total Amount</dt>
                <dd class="inv-cell-price" style="font-size: 1.1rem;">PKR @Model.TotalAmount.ToString("F2")</dd>
            </dl>
        </div>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div style="margin-bottom: 24px;">
                <h4 style="font-weight: 700; color: #2c5282; margin-bottom: 12px;">Invoice Items</h4>
                <table class="inv-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int index = 1; }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@(index++)</td>
                                <td>@(item.Product?.Name ?? "Unknown Product")</td>
                                <td>PKR @item.Price.ToString("F2")</td>
                                <td class="inv-cell-qty">@item.Quantity</td>
                                <td class="inv-cell-price">PKR @(item.Total.ToString("F2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="inv-confirm-actions">
            <a asp-action="Index" class="inv-btn inv-btn-outline">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inv-btn inv-btn-warning">
                <i class="bi bi-pencil"></i> Edit Invoice
            </a>
        </div>

    </div>
</div>