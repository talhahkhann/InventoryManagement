@model InventoryManagement.ViewModels.InvoiceViewModel

@{
    bool isEditMode = Model.Id > 0;
    ViewData["Title"]       = isEditMode ? "Edit Invoice" : "Create Invoice";
    ViewData["HeaderIcon"]  = "bi-receipt-cutoff";
    ViewData["HeaderTitle"] = isEditMode ? $"EDIT INVOICE #{Model.Id}" : "CREATE INVOICE";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-form-area">
    <form id="invoiceForm" asp-action="@(isEditMode ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEditMode)
        {
            <input type="hidden" asp-for="Id" />
        }

        <!-- Customer & Area Selection -->
        <section class="inv-section">
            <div class="inv-section-header">
                <h2 class="inv-section-title">
                    <i class="bi bi-geo-alt"></i> Customer Details
                </h2>
            </div>
            
            <div class="inv-field-row">
                <div class="inv-field-col">
                    <label class="inv-field-label required">Area</label>
                    <select id="AreaId" class="inv-field-select">
                        <option value="">-- Select Area --</option>
                        @foreach (var area in Model.Areas)
                        {
                            <option value="@area.AreaId" selected="@(Model.Customer?.AreaId == area.AreaId)">
                                @area.AreaName
                            </option>
                        }
                    </select>
                </div>
                
                <div class="inv-field-col">
                    <label asp-for="CustomerId" class="inv-field-label required">Customer</label>
                    <select asp-for="CustomerId" id="CustomerId" class="inv-field-select">
                        <option value="">-- Select Customer --</option>
                        @if (Model.Customer != null)
                        {
                            <option value="@Model.Customer.Id" selected="selected">
                                @Model.Customer.Name
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CustomerId" class="inv-field-error"></span>
                </div>
            </div>
        </section>

        <!-- Invoice Table / Line Items -->
        <section class="inv-section">
            <div class="inv-section-header">
                <h2 class="inv-section-title">
                    <i class="bi bi-cart-check"></i> Invoice Items
                </h2>
            </div>

            <table id="invoiceTable" class="inv-table inv-invoice-table">
                <thead>
                    <tr>
                        <th style="width:46px;">#</th>
                        <th>Product</th>
                        <th style="width:155px;">Price</th>
                        <th style="width:110px;">Qty</th>
                        <th style="width:145px;">Total</th>
                        <th style="width:70px;" class="center">Del</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr class="invoiceRow">
                                <td class="rowIndex inv-inv-cell-num">@(i + 1)</td>
                                <td class="inv-inv-cell-product">
                                    <div class="autocomplete">
                                        <input type="text"
                                               class="autocomplete-input productName inv-field-input"
                                               value="@Model.Items[i].ProductName"
                                               placeholder="Type product name…"
                                               autocomplete="off" />
                                        <input type="hidden" name="Items[@i].ProductId" class="productId" value="@Model.Items[i].ProductId" />
                                        <input type="hidden" name="Items[@i].ProductName" value="@Model.Items[i].ProductName" />
                                    </div>
                                </td>
                                <td class="inv-inv-cell-fixed">
                                    <input type="text" name="Items[@i].Price" class="price price-editable inv-field-input" value="@Model.Items[i].Price.ToString("F2")" />
                                    <span class="price-note"></span>
                                </td>
                                <td class="inv-inv-cell-fixed">
                                    <input type="number" name="Items[@i].Quantity" class="quantity inv-field-input" value="@Model.Items[i].Quantity" min="1" />
                                </td>
                                <td class="inv-inv-cell-fixed">
                                    <input type="text" class="total inv-field-input inv-total-readonly" readonly value="@Model.Items[i].Total.ToString("F2")" />
                                </td>
                                <td class="center inv-inv-cell-num">
                                    <button type="button" class="inv-btn inv-btn-danger inv-btn-sm removeRow" style="min-width:auto;padding:8px 10px;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="invoiceRow">
                            <td class="rowIndex inv-inv-cell-num">1</td>
                            <td class="inv-inv-cell-product">
                                <div class="autocomplete">
                                    <input type="text"
                                           class="autocomplete-input productName inv-field-input"
                                           placeholder="Type product name…"
                                           autocomplete="off" />
                                    <input type="hidden" name="Items[0].ProductId" class="productId" value="" />
                                    <input type="hidden" name="Items[0].ProductName" value="" />
                                </div>
                            </td>
                            <td class="inv-inv-cell-fixed">
                                <input type="text" name="Items[0].Price" class="price price-editable inv-field-input" value="0.00" />
                                <span class="price-note"></span>
                            </td>
                            <td class="inv-inv-cell-fixed">
                                <input type="number" name="Items[0].Quantity" class="quantity inv-field-input" value="1" min="1" />
                            </td>
                            <td class="inv-inv-cell-fixed">
                                <input type="text" class="total inv-field-input inv-total-readonly" readonly value="0.00" />
                            </td>
                            <td class="center inv-inv-cell-num">
                                <button type="button" class="inv-btn inv-btn-danger inv-btn-sm removeRow" style="min-width:auto;padding:8px 10px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="grand-total-row">
                        <td colspan="4" class="text-end" style="text-align: right; font-weight: 700; font-size: 1rem; vertical-align: middle;">GRAND TOTAL:</td>
                        <td colspan="2" style="text-align: left; vertical-align: middle;">
                            <span id="grandTotal" class="grand-total-value">@Model.TotalAmount.ToString("F2")</span>
                        </td>
                    </tr>
                </tfoot>
            </table>
            
            <div class="add-row-container" style="display: flex; justify-content: flex-end; margin-top: 16px;">
                <button type="button" id="addRow" class="inv-btn inv-btn-success">
                    <i class="bi bi-plus-circle"></i> Add Item
                </button>
            </div>
        </section>

        <!-- Form Actions -->
        <div class="inv-form-footer">
            <a asp-action="Index" class="inv-btn inv-btn-outline">
                <i class="bi bi-x-circle"></i> Cancel
            </a>
            <button type="button" id="previewBtn" class="inv-btn inv-btn-info">
                <i class="bi bi-eye"></i> Preview Invoice
            </button>
            <button type="submit" class="inv-btn inv-btn-primary">
                <i class="bi bi-save"></i> @(isEditMode ? "Update Invoice" : "Save Invoice")
            </button>
        </div>
    </form>
</div>

<!-- Preview Modal Overlay -->
<div id="previewModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h2 style="font-size: 1.25rem; font-weight: 700;">Invoice Preview</h2>
            <button type="button" id="closePreview" style="background: none; border: none; color: white; font-size: 24px; cursor: pointer;">×</button>
        </div>
        <div class="modal-body">
            <div class="invoice-preview" id="invoicePreviewContent">
                <!-- Dynamically generated invoice preview -->
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="printBtn" class="inv-btn inv-btn-outline">
                <i class="bi bi-printer"></i> Print / Save PDF
            </button>
            <button type="button" id="saveFromPreview" class="inv-btn inv-btn-primary">
                <i class="bi bi-save"></i> @(isEditMode ? "Update Invoice" : "Save Invoice")
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/site.js"></script>
    <script src="/js/invoice.js"></script>

    <script>
        // Pass server-serialized data into the invoice module
        document.addEventListener('DOMContentLoaded', function () {
            initInvoiceForm(
                @Html.Raw(Json.Serialize(Model.Products.Select(p => new {
                    id    = p.Id,
                    name  = p.Name,
                    price = p.Price
                }))),
                @Html.Raw(Json.Serialize(Model.Areas.Select(a => new {
                    id   = a.AreaId,
                    name = a.AreaName
                }))),
                @Html.Raw(Json.Serialize(Model.Customers.Select(c => new {
                    id     = c.Id,
                    name   = c.Name,
                    areaId = c.AreaId
                })))
            );
        });
    </script>
}