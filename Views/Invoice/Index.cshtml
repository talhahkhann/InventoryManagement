@model IEnumerable<InventoryManagement.Models.Invoice>

@{
    ViewData["Title"]       = "Invoices";
    ViewData["HeaderIcon"]  = "bi-receipt-cutoff";
    ViewData["HeaderTitle"] = "INVOICES";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <section class="inv-section">

        @* Success / Error banners *@
        @if (TempData["Success"] is string ok)
        {
            <div class="inv-alert inv-alert-success">
                <i class="bi bi-check-circle-fill"></i> @ok
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="inv-alert inv-alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i> @err
            </div>
        }

        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-list-ul"></i> Invoice List
            </h2>
            <a asp-action="Create" class="inv-btn inv-btn-primary">
                <i class="bi bi-plus-circle"></i> Create New Invoice
            </a>
        </div>

        @if (Model?.Any() == true)
        {
            @await Html.PartialAsync("_SearchBar", new ViewDataDictionary(ViewData) {
                { "InputId",     "invoiceSearch"      },
                { "ClearId",     "invoiceSearchClear" },
                { "Placeholder", "Search by customer, date, amount..." }
            })

            <table class="inv-table">
                <thead>
                    <tr>
                        <th style="width:80px;">Invoice #</th>
                        <th>Customer</th>
                        <th style="width:140px;">Date</th>
                        <th style="width:140px;">Total</th>
                        <th class="center" style="width:160px;">Actions</th>
                    </tr>
                </thead>
                <tbody id="invoicesTbody">
                    @foreach (var invoice in Model)
                    {
                        <tr>
                            <td data-label="Invoice #" class="inv-cell-muted">#@invoice.Id</td>
                            <td data-label="Customer"><strong>@(invoice.Customer?.Name ?? "Unknown")</strong></td>
                            <td data-label="Date" class="inv-cell-muted">@invoice.InvoiceDate.ToString("MMM dd, yyyy")</td>
                            <td data-label="Total" class="inv-cell-price">PKR @invoice.TotalAmount.ToString("F2")</td>
                            <td data-label="Actions" class="center">
                                <div class="inv-actions">
                                    <a asp-action="Details" asp-route-id="@invoice.Id"
                                       class="inv-btn inv-btn-info inv-btn-sm" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@invoice.Id"
                                       class="inv-btn inv-btn-warning inv-btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@invoice.Id"
                                       class="inv-btn inv-btn-danger inv-btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState",
                ("bi-receipt", "No invoices found", "Create your first invoice to get started."))
        }

    </section>
</div>

@section Scripts {
    <script src="/js/search.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            TableSearchService.init({
                inputId:       'invoiceSearch',
                clearBtnId:    'invoiceSearchClear',
                tbodyId:       'invoicesTbody',
                columnIndexes: [0, 1, 2, 3]
            });
        });
    </script>
}
