@model InventoryManagement.ViewModels.RegisterViewModel;

<h2>Register</h2>

<form asp-action="Register" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="FullName"></label>
        <input asp-for="FullName" placeholder="Full Name" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" placeholder="Email" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" placeholder="Password" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" placeholder="Phone Number" type="tel" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Address"></label>
        <input asp-for="Address" placeholder="Address" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Country"></label>
        <input asp-for="Country" placeholder="Country" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Role"></label>
        <select asp-for="Role">
            <option value="Admin">Admin</option>
            <option value="Manager">Manager</option>
            <option value="Staff">Staff</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>

    <button type="submit">Register</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
