@model InventoryManagement.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Full custom page — no layout wrapper
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Inventory Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0f1f3d;
        }

        /* Two-column split */
        .login-page {
            display: flex;
            min-height: 100vh;
        }

        /* Left panel — branding */
        .login-brand {
            flex: 1;
            background: linear-gradient(160deg, #1a3a6c 0%, #2c5282 50%, #1a3a6c 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 40px;
            position: relative;
            overflow: hidden;
        }

        /* decorative circles */
        .login-brand::before,
        .login-brand::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }
        .login-brand::before { width: 500px; height: 500px; top: -120px; right: -160px; }
        .login-brand::after  { width: 340px; height: 340px; bottom: -100px; left: -80px; }

        .login-brand-icon {
            font-size: 4.5rem;
            color: #90cdf4;
            margin-bottom: 28px;
            position: relative;
            z-index: 1;
        }

        .login-brand-title {
            font-size: 2rem;
            font-weight: 800;
            color: #fff;
            text-align: center;
            letter-spacing: -0.5px;
            line-height: 1.2;
            position: relative;
            z-index: 1;
            margin-bottom: 16px;
        }

        .login-brand-sub {
            font-size: 0.95rem;
            color: #90cdf4;
            text-align: center;
            max-width: 300px;
            line-height: 1.7;
            position: relative;
            z-index: 1;
        }

        .login-brand-features {
            margin-top: 48px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 320px;
        }

        .login-feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #bfdbfe;
            font-size: 0.875rem;
        }

        .login-feature-item i {
            font-size: 1.1rem;
            color: #60a5fa;
            flex-shrink: 0;
        }

        /* Right panel — form */
        .login-form-panel {
            width: 460px;
            flex-shrink: 0;
            background: #fff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 48px;
        }

        .login-form-inner {
            width: 100%;
            max-width: 360px;
        }

        .login-form-header {
            text-align: center;
            margin-bottom: 36px;
        }

        .login-form-header h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1a202c;
            margin-bottom: 6px;
        }

        .login-form-header p {
            color: #718096;
            font-size: 0.875rem;
        }

        /* Field */
        .lf-group {
            margin-bottom: 20px;
        }

        .lf-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            color: #4a5568;
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .lf-input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .lf-icon {
            position: absolute;
            left: 14px;
            color: #a0aec0;
            font-size: 1rem;
            pointer-events: none;
        }

        .lf-input {
            width: 100%;
            padding: 12px 42px;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: 0.9rem;
            color: #2d3748;
            background: #f8fafc;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .lf-input:focus {
            outline: none;
            border-color: #3182ce;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(49,130,206,0.15);
        }

        .lf-input::placeholder { color: #cbd5e0; }

        .lf-toggle {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #a0aec0;
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
            transition: color 0.15s;
            font-size: 1rem;
        }
        .lf-toggle:hover { color: #4a5568; }

        .lf-error {
            color: #e53e3e;
            font-size: 0.78rem;
            margin-top: 5px;
            display: block;
        }

        /* Error banner */
        .lf-error-banner {
            background: #fff5f5;
            border: 1px solid #feb2b2;
            border-radius: 8px;
            padding: 11px 14px;
            margin-bottom: 20px;
            font-size: 0.82rem;
            color: #c53030;
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }

        .lf-error-banner i { flex-shrink: 0; margin-top: 1px; }

        /* Submit */
        .lf-submit {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2c5282, #3182ce);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin-top: 8px;
        }

        .lf-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(49,130,206,0.35);
        }

        .lf-submit:active { transform: translateY(0); }

        .lf-footer-note {
            text-align: center;
            margin-top: 28px;
            font-size: 0.8rem;
            color: #a0aec0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* Responsive: stack on small screens */
        @@media (max-width: 820px) {
            .login-brand { display: none; }
            .login-form-panel {
                width: 100%;
                padding: 40px 24px;
            }
        }
    </style>
</head>
<body>
<div class="login-page">

    @* ── LEFT: branding panel ── *@
    <div class="login-brand">
        <i class="bi bi-boxes login-brand-icon"></i>
        <h2 class="login-brand-title">Inventory<br/>Management</h2>
        <p class="login-brand-sub">A complete system to manage products, customers, invoices, and analytics in one place.</p>

        <div class="login-brand-features">
            <div class="login-feature-item">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Real-time profit analytics</span>
            </div>
            <div class="login-feature-item">
                <i class="bi bi-receipt"></i>
                <span>Invoice & sales management</span>
            </div>
            <div class="login-feature-item">
                <i class="bi bi-bell-fill"></i>
                <span>Automatic stock alerts</span>
            </div>
            <div class="login-feature-item">
                <i class="bi bi-shield-check"></i>
                <span>Role-based access control</span>
            </div>
        </div>
    </div>

    @* ── RIGHT: login form ── *@
    <div class="login-form-panel">
        <div class="login-form-inner">

            <div class="login-form-header">
                <h1>Welcome back</h1>
                <p>Sign in to continue to your dashboard</p>
            </div>

            @* Server-side error banner *@
            @{
                var hasSummaryErrors = !ViewData.ModelState.IsValid &&
                    ViewData.ModelState.Any(x => x.Value?.Errors.Count > 0);
            }
            @if (hasSummaryErrors)
            {
                <div class="lf-error-banner">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>
                        @foreach (var state in ViewData.ModelState.Values)
                        {
                            foreach (var error in state.Errors)
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        }
                    </div>
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="lf-group">
                    <label class="lf-label" asp-for="Email">Email Address</label>
                    <div class="lf-input-wrap">
                        <i class="bi bi-envelope lf-icon"></i>
                        <input asp-for="Email" type="email" class="lf-input"
                               placeholder="admin@inventory.com"
                               autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="lf-error"></span>
                </div>

                <div class="lf-group">
                    <label class="lf-label" asp-for="Password">Password</label>
                    <div class="lf-input-wrap">
                        <i class="bi bi-lock lf-icon"></i>
                        <input asp-for="Password" type="password" class="lf-input"
                               id="passwordInput"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button" class="lf-toggle" id="togglePassword" title="Show/hide password" tabindex="-1">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="lf-error"></span>
                </div>

                <button type="submit" class="lf-submit">
                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                </button>
            </form>

            <p class="lf-footer-note">
                <i class="bi bi-shield-lock"></i>
                No account? Contact your administrator.
            </p>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            var input = document.getElementById('passwordInput');
            var icon  = document.getElementById('toggleIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        });
    </script>
}
</body>
</html>
