@model IEnumerable<InventoryManagement.ViewModels.AreaViewModel>

@{
    ViewData["Title"] = "Areas";
}

<div class="container-fluid py-4">

    ```
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Areas</h2>
            <p class="text-muted mb-0">Manage your inventory areas</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Area
        </a>
    </div>

    <!-- Area Card -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-geo-alt fs-1 text-muted"></i>
                    </div>

                    <h5>No Areas Found</h5>
                    <p class="text-muted">
                        Start by creating your first area.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        Add Area
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">#</th>
                                <th>Area Name</th>
                                <th class="text-end" style="width: 180px;">
                                    Actions
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var area in Model)
                            {
                                <tr>
                                    <td class="text-muted">
                                        @area.Id
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10
                                                            rounded-circle
                                                            d-flex align-items-center
                                                            justify-content-center me-3"
                                                 style="width:40px;height:40px;">
                                                <i class="bi bi-geo-alt text-primary"></i>
                                            </div>

                                            <span class="fw-semibold">
                                                @area.Name
                                            </span>
                                        </div>
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@area.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@area.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
    ```

</div>
