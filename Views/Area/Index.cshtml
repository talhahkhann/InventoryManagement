@model IEnumerable<InventoryManagement.ViewModels.AreaViewModel>

@{
    ViewData["Title"]       = "Areas";
    ViewData["HeaderIcon"]  = "bi-geo-alt-fill";
    ViewData["HeaderTitle"] = "AREAS";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <section class="inv-section">

        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-geo-alt-fill"></i> Manage Areas
            </h2>
            <a asp-action="Create" class="inv-btn inv-btn-primary">
                <i class="bi bi-plus-circle"></i> Add Area
            </a>
        </div>

        @if (Model?.Any() == true)
        {
            @await Html.PartialAsync("_SearchBar", new ViewDataDictionary(ViewData) {
                { "InputId",     "areaSearch"      },
                { "ClearId",     "areaSearchClear" },
                { "Placeholder", "Search areas..." }
            })

            <table class="inv-table">
                <thead>
                    <tr>
                        <th style="width:80px;">#</th>
                        <th>Area Name</th>
                        <th class="center">Actions</th>
                    </tr>
                </thead>
                <tbody id="areasTbody">
                    @{ int row = 1; }
                    @foreach (var area in Model)
                    {
                        <tr>
                            <td data-label="#">@(row++)</td>
                            <td data-label="Area Name">
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div style="width:34px;height:34px;border-radius:50%;background:#ebf8ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <i class="bi bi-geo-alt" style="color:#3182ce;"></i>
                                    </div>
                                    <strong>@area.Name</strong>
                                </div>
                            </td>
                            <td data-label="Actions" class="center">
                                <div class="inv-actions">
                                    <a asp-action="Edit" asp-route-id="@area.Id"
                                       class="inv-btn inv-btn-warning inv-btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@area.Id"
                                       class="inv-btn inv-btn-danger inv-btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState",
                ("bi-geo-alt", "No areas found", "Add your first area to get started."))
        }

    </section>
</div>

@section Scripts {
    <script src="/js/search.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            TableSearchService.init({
                inputId:       'areaSearch',
                clearBtnId:    'areaSearchClear',
                tbodyId:       'areasTbody',
                columnIndexes: [1]
            });
        });
    </script>
}
