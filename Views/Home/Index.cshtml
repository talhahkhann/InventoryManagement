@model DashboardViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<InventoryManagement.Models.ApplicationUser> SignInManager
@inject UserManager<InventoryManagement.Models.ApplicationUser>   UserManager

@{
    ViewData["Title"]       = "Dashboard";
    ViewData["HeaderIcon"]  = "bi-speedometer2";
    ViewData["HeaderTitle"] = "DASHBOARD";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";

    var currentUser = await UserManager.GetUserAsync(User);
    var firstName   = currentUser?.FullName?.Split(' ').FirstOrDefault() ?? "there";
    var isAdmin     = User.IsInRole("Admin");
    var isManager   = User.IsInRole("Manager");
    var isStaff     = User.IsInRole("Staff");
    var roleLabel   = isAdmin ? "Admin" : isManager ? "Manager" : "Staff";
    var hour        = DateTime.Now.Hour;
    var greeting    = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
}

<div class="inv-content">

    @* ── Welcome banner ───────────────────────────────────────────────── *@
    <div class="dash-welcome">
        <div class="dash-welcome-left">
            <div class="dash-welcome-greeting">@greeting, @firstName 👋</div>
            <div class="dash-welcome-sub">
                Here's what's happening in your inventory today.
            </div>
        </div>
        <div class="dash-welcome-badge">
            <i class="bi bi-shield-check"></i>
            <span>@roleLabel</span>
        </div>
    </div>

    @* ── KPI stat cards ───────────────────────────────────────────────── *@
    <div class="dash-kpi-grid">

        @* Invoices — all roles *@
        @if (isAdmin || isManager)
        {
            <a asp-controller="Invoice" asp-action="Index" class="dash-kpi-card dash-kpi-blue">
                <div class="dash-kpi-icon"><i class="bi bi-receipt-cutoff"></i></div>
                <div class="dash-kpi-body">
                    <div class="dash-kpi-value">@Model.InvoiceCount</div>
                    <div class="dash-kpi-label">Total Invoices</div>
                </div>
                <i class="bi bi-arrow-right-short dash-kpi-arrow"></i>
            </a>
        }

        @* Customers *@
        @if (isAdmin || isManager)
        {
            <a asp-controller="Customer" asp-action="Index" class="dash-kpi-card dash-kpi-green">
                <div class="dash-kpi-icon"><i class="bi bi-people-fill"></i></div>
                <div class="dash-kpi-body">
                    <div class="dash-kpi-value">@Model.CustomerCount</div>
                    <div class="dash-kpi-label">Customers</div>
                </div>
                <i class="bi bi-arrow-right-short dash-kpi-arrow"></i>
            </a>
        }

        @* Products *@
        @if (isAdmin || isManager)
        {
            <a asp-controller="Products" asp-action="Index" class="dash-kpi-card dash-kpi-orange">
                <div class="dash-kpi-icon"><i class="bi bi-boxes"></i></div>
                <div class="dash-kpi-body">
                    <div class="dash-kpi-value">@Model.ProductCount</div>
                    <div class="dash-kpi-label">Products</div>
                </div>
                <i class="bi bi-arrow-right-short dash-kpi-arrow"></i>
            </a>
        }

        @* Staff: new invoice card *@
        @if (isStaff)
        {
            <a asp-controller="Invoice" asp-action="Create" class="dash-kpi-card dash-kpi-blue" style="cursor:pointer;">
                <div class="dash-kpi-icon"><i class="bi bi-plus-square-fill"></i></div>
                <div class="dash-kpi-body">
                    <div class="dash-kpi-value">New</div>
                    <div class="dash-kpi-label">Create Invoice</div>
                </div>
                <i class="bi bi-arrow-right-short dash-kpi-arrow"></i>
            </a>
        }

    </div>

    @* ── Quick-action panels (Admin / Manager only) ───────────────────── *@
    @if (isAdmin || isManager)
    {
        <div class="dash-panels">

            @* Inventory panel *@
            <section class="inv-section dash-panel">
                <div class="inv-section-header">
                    <h2 class="inv-section-title"><i class="bi bi-grid-3x3-gap"></i> Inventory</h2>
                </div>
                <div class="dash-action-grid">
                    <a asp-controller="Invoice" asp-action="Create" class="dash-action-btn dash-action-blue">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>New Invoice</span>
                    </a>
                    <a asp-controller="Invoice" asp-action="Index" class="dash-action-btn dash-action-teal">
                        <i class="bi bi-receipt"></i>
                        <span>All Invoices</span>
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="dash-action-btn dash-action-orange">
                        <i class="bi bi-boxes"></i>
                        <span>Products</span>
                    </a>
                    <a asp-controller="Categories" asp-action="Index" class="dash-action-btn dash-action-purple">
                        <i class="bi bi-tags-fill"></i>
                        <span>Categories</span>
                    </a>
                    <a asp-controller="Customer" asp-action="Index" class="dash-action-btn dash-action-green">
                        <i class="bi bi-people-fill"></i>
                        <span>Customers</span>
                    </a>
                    <a asp-controller="Area" asp-action="Index" class="dash-action-btn dash-action-slate">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>Areas</span>
                    </a>
                    <a asp-controller="PurchaseOrder" asp-action="Create" class="dash-action-btn dash-action-green">
                        <i class="bi bi-box-arrow-in-down"></i>
                        <span>New PO</span>
                    </a>
                    <a asp-controller="Suppliers" asp-action="Index" class="dash-action-btn dash-action-slate">
                        <i class="bi bi-truck"></i>
                        <span>Suppliers</span>
                    </a>
                </div>
            </section>

            @* Analytics panel *@
            <section class="inv-section dash-panel">
                <div class="inv-section-header">
                    <h2 class="inv-section-title"><i class="bi bi-bar-chart-fill"></i> Analytics</h2>
                </div>
                <div class="dash-action-grid">
                    <a asp-controller="Profit" asp-action="Index" class="dash-action-btn dash-action-green">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Profit</span>
                    </a>
                    <a asp-controller="Profit" asp-action="ByMonth" class="dash-action-btn dash-action-blue">
                        <i class="bi bi-calendar3"></i>
                        <span>Monthly</span>
                    </a>
                    <a asp-controller="Profit" asp-action="ByProduct" class="dash-action-btn dash-action-orange">
                        <i class="bi bi-box-seam"></i>
                        <span>By Product</span>
                    </a>
                    <a asp-controller="Profit" asp-action="ByCustomer" class="dash-action-btn dash-action-purple">
                        <i class="bi bi-person-lines-fill"></i>
                        <span>By Customer</span>
                    </a>
                    <a asp-controller="Reports" asp-action="SalesPerProduct" class="dash-action-btn dash-action-teal">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Sales Report</span>
                    </a>
                    <a asp-controller="Reports" asp-action="TopProducts" class="dash-action-btn dash-action-orange">
                        <i class="bi bi-trophy"></i>
                        <span>Top Products</span>
                    </a>
                    <a asp-controller="Reports" asp-action="TopCustomers" class="dash-action-btn dash-action-purple">
                        <i class="bi bi-person-badge-fill"></i>
                        <span>Top Customers</span>
                    </a>
                    <a asp-controller="StockAlert" asp-action="Index" class="dash-action-btn dash-action-red">
                        <i class="bi bi-bell-fill"></i>
                        <span>Stock Alerts</span>
                    </a>
                </div>
            </section>

        </div>

        @* Admin-only panel *@
        @if (isAdmin)
        {
            <section class="inv-section" style="margin-top:0;">
                <div class="inv-section-header">
                    <h2 class="inv-section-title"><i class="bi bi-shield-lock-fill"></i> Administration</h2>
                </div>
                <div class="dash-action-grid" style="max-width:460px;">
                    <a asp-controller="Admin" asp-action="Users" class="dash-action-btn dash-action-slate">
                        <i class="bi bi-people-fill"></i>
                        <span>User Management</span>
                    </a>
                    <a asp-controller="Admin" asp-action="CreateUser" class="dash-action-btn dash-action-blue">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>Add User</span>
                    </a>
                </div>
            </section>
        }
    }

    @* ── Staff view ───────────────────────────────────────────────────── *@
    @if (isStaff)
    {
        <section class="inv-section">
            <div class="inv-section-header">
                <h2 class="inv-section-title"><i class="bi bi-plus-square"></i> Your Actions</h2>
            </div>
            <div class="dash-action-grid" style="max-width:320px;">
                <a asp-controller="Invoice" asp-action="Create" class="dash-action-btn dash-action-blue">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>New Invoice</span>
                </a>
            </div>
            <p style="margin-top:20px; color:#718096; font-size:0.875rem;">
                <i class="bi bi-info-circle me-1"></i>
                Need access to more features? Contact your administrator.
            </p>
        </section>
    }

</div>
