@model IEnumerable<InventoryManagement.ViewModels.ProductViewModel>

@{
    ViewData["Title"]       = "Products";
    ViewData["HeaderIcon"]  = "bi-boxes";
    ViewData["HeaderTitle"] = "PRODUCTS";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <section class="inv-section">

        @* Section header: title + Add button *@
        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-list-ul"></i> Product Inventory
            </h2>
            <a asp-action="Create" class="inv-btn inv-btn-primary">
                <i class="bi bi-plus-circle"></i> Add Product
            </a>
        </div>

        @if (Model?.Any() == true)
        {
            @await Html.PartialAsync("_SearchBar", new ViewDataDictionary(ViewData) {
                { "InputId",     "productSearch"      },
                { "ClearId",     "productSearchClear" },
                { "Placeholder", "Search by name, category..." }
            })

            <table class="inv-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Product Name</th>
                        <th>Quantity</th>
                        <th>Alert At</th>
                        <th>Price</th>
                        <th>Category</th>
                        <th class="center">Actions</th>
                    </tr>
                </thead>
                <tbody id="productsTbody">
                    @{int row = 1;}
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="#">@(row++)</td>
                            <td data-label="Product Name">@item.Name</td>
                            <td data-label="Quantity" class="inv-cell-qty @(item.Quantity <= item.StockThreshold ? "inv-stock-low" : "")">
                                @item.Quantity
                                @if (item.Quantity == 0)
                                {
                                    <span class="sa-badge-critical" style="margin-left:6px;font-size:.7rem;">Out</span>
                                }
                                else if (item.Quantity <= item.StockThreshold)
                                {
                                    <span class="sa-badge-warning" style="margin-left:6px;font-size:.7rem;">Low</span>
                                }
                            </td>
                            <td data-label="Alert At" class="inv-cell-muted">@item.StockThreshold</td>
                            <td data-label="Price" class="inv-cell-price">@item.Price.ToString("C")</td>
                            <td data-label="Category" class="inv-cell-muted">@item.CategoryId</td>
                            <td data-label="Actions"  class="center">
                                <div class="inv-actions">
                                    <a asp-action="Edit"   asp-route-id="@item.Id" class="inv-btn inv-btn-warning inv-btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="inv-btn inv-btn-danger inv-btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState",
                ("bi-inbox", "No products found", "Add your first product to get started."))
        }

    </section>
</div>

@section Scripts {
    <script src="/js/search.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            TableSearchService.init({
                inputId:       'productSearch',
                clearBtnId:    'productSearchClear',
                tbodyId:       'productsTbody',
                columnIndexes: [1, 5]   // Product Name, Category
            });
        });
    </script>
}
