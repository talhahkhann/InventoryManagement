@model InventoryManagement.ViewModels.AlertNotificationViewModel

<div class="alert-dropdown">
    <button class="alert-bell" id="alertBell" onclick="toggleAlertDropdown()">
        <i class="bi bi-bell-fill"></i>
        @if (Model.UnresolvedCount > 0)
        {
            <span class="alert-badge">@Model.UnresolvedCount</span>
        }
    </button>
    
    <div class="alert-menu" id="alertMenu">
        <div class="alert-header">
            <span>Stock Alerts</span>
            @if (Model.UnresolvedCount > 0)
            {
                <span class="alert-count">@Model.UnresolvedCount active</span>
            }
        </div>
        
        @if (Model.RecentAlerts.Any())
        {
            <div class="alert-list">
                @foreach (var alert in Model.RecentAlerts)
                {
                    <div class="alert-item @(alert.Severity == "Critical" ? "alert-critical" : "alert-warning")" data-id="@alert.Id">
                        <div class="alert-icon">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </div>
                        <div class="alert-content">
                            <div class="alert-title">@alert.ProductName</div>
                            <div class="alert-meta">
                                Stock: <strong>@alert.CurrentStock</strong> / Threshold: @alert.Threshold
                            </div>
                            <div class="alert-time">@alert.CreatedAt.ToString("MMM dd, HH:mm")</div>
                        </div>
                        <button class="alert-resolve" onclick="resolveAlert(@alert.Id, this)" title="Resolve">
                            <i class="bi bi-check-lg"></i>
                        </button>
                    </div>
                }
            </div>
            @if (Model.UnresolvedCount > 5)
            {
                <div class="alert-footer">
                    <a href="@Url.Action("Index", "StockAlert")">
                        View all @Model.UnresolvedCount alerts
                    </a>
                </div>
            }
        }
        else
        {
            <div class="alert-empty">
                <i class="bi bi-check-circle"></i>
                <span>No active stock alerts</span>
            </div>
        }
    </div>
</div>