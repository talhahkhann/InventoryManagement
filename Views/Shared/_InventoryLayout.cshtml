<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Inventory Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="inv-root">

        @* Page Header *@
        <header class="inv-header">
            <div class="inv-header-logo">
                <i class="bi @(ViewData["HeaderIcon"] ?? "bi-boxes") inv-header-icon"></i>
                <span class="inv-header-title">@(ViewData["HeaderTitle"] ?? ViewData["Title"])</span>
            </div>

            <div class="inv-header-actions">
                @* Alert bell — shared across all inventory pages *@
                @await Component.InvokeAsync("AlertNotification")

                @if (IsSectionDefined("HeaderActions"))
                {
                    @RenderSection("HeaderActions", required: false)
                }
            </div>
        </header>

        @* Main Content *@
        <main class="inv-main">
            @RenderBody()
        </main>

    </div>

    @* Core scripts — available to every inv-layout page *@
    <script src="/js/site.js"></script>
    <script src="/js/stockalert.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            StockAlertService.initBell();
            StockAlertService.startAutoRefresh();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
