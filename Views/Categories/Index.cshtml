@model IEnumerable<InventoryManagement.ViewModels.CategoryViewModel>

@{
    ViewData["Title"]       = "Categories";
    ViewData["HeaderIcon"]  = "bi-tags";
    ViewData["HeaderTitle"] = "CATEGORIES";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <section class="inv-section">

        @* Section header: title + Add button *@
        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-tag-fill"></i> Category List
            </h2>
            <a asp-action="Create" class="inv-btn inv-btn-primary">
                <i class="bi bi-plus-circle"></i> Add Category
            </a>
        </div>

        @if (Model?.Any() == true)
        {
            <table class="inv-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Category Name</th>
                        <th class="center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int row = 1; }
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td data-label="#">@(row++)</td>
                            <td data-label="Category Name">@category.Name</td>
                            <td data-label="Actions" class="center">
                                <div class="inv-actions">
                                    <a asp-action="Edit"   asp-route-id="@category.Id"
                                       class="inv-btn inv-btn-warning inv-btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@category.Id"
                                       class="inv-btn inv-btn-danger inv-btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState",
                ("bi-tags", "No categories found", "Add your first category to get started."))
        }

    </section>
</div>
