@model IEnumerable<InventoryManagement.ViewModels.CustomerViewModel>

@{
    ViewData["Title"]       = "Customers";
    ViewData["HeaderIcon"]  = "bi-people-fill";
    ViewData["HeaderTitle"] = "CUSTOMERS";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <section class="inv-section">

        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-person-lines-fill"></i> Customer Directory
            </h2>
            <a asp-action="Create" class="inv-btn inv-btn-primary">
                <i class="bi bi-person-plus"></i> Add Customer
            </a>
        </div>

        @if (Model?.Any() == true)
        {
            @* Area filter *@
            <div class="inv-filter-bar">
                <span class="inv-filter-label">
                    <i class="bi bi-geo-alt"></i> Filter by Area
                </span>
                <select id="areaDropdown" class="inv-field-select" style="max-width:260px;">
                    <option value="">All Areas</option>
                    @if (ViewBag.Areas != null)
                    {
                        foreach (var area in ViewBag.Areas)
                        {
                            <option value="@area.AreaId">@area.AreaName</option>
                        }
                    }
                </select>
                <span id="loading" class="inv-filter-loading" style="display:none;">
                    <i class="bi bi-arrow-repeat"></i> Loading…
                </span>
            </div>

            @await Html.PartialAsync("_SearchBar", new ViewDataDictionary(ViewData) {
                { "InputId",     "customerSearch"      },
                { "ClearId",     "customerSearchClear" },
                { "Placeholder", "Search by name, email, phone, city..." }
            })

            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Country</th>
                        <th class="center">Actions</th>
                    </tr>
                </thead>
                <tbody id="customerTableBody">
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td data-label="Name"><strong>@customer.Name</strong></td>
                            <td data-label="Email" class="inv-cell-muted">@customer.Email</td>
                            <td data-label="Phone" class="inv-cell-muted">@customer.PhoneNumber</td>
                            <td data-label="City"  class="inv-cell-muted">@customer.City</td>
                            <td data-label="Country" class="inv-cell-muted">@customer.Country</td>
                            <td data-label="Actions" class="center">
                                <div class="inv-actions">
                                    <a asp-action="History" asp-route-id="@customer.Id"
                                       class="inv-btn inv-btn-info inv-btn-sm" title="Purchase History">
                                        <i class="bi bi-clock-history"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@customer.Id"
                                       class="inv-btn inv-btn-warning inv-btn-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@customer.Id"
                                       class="inv-btn inv-btn-danger inv-btn-sm" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @await Html.PartialAsync("_EmptyState",
                ("bi-people", "No customers found", "Add your first customer to get started."))
        }

    </section>
</div>

@section Scripts {
    <script src="/js/search.js"></script>
    <script src="/js/customer.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            initCustomerAreaFilter('@Url.Action("GetCustomersByArea", "Customer")');

            TableSearchService.init({
                inputId:       'customerSearch',
                clearBtnId:    'customerSearchClear',
                tbodyId:       'customerTableBody',
                columnIndexes: [0, 1, 2, 3, 4]
            });

            document.getElementById('areaDropdown').addEventListener('change', function () {
                setTimeout(() => TableSearchService.refresh('customerSearch'), 400);
            });
        });
    </script>
}
