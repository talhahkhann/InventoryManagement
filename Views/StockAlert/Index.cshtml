@model List<InventoryManagement.ViewModels.StockAlertViewModel>

@{
    ViewData["Title"]       = "Stock Alerts";
    ViewData["HeaderIcon"]  = "bi-exclamation-triangle-fill";
    ViewData["HeaderTitle"] = "STOCK ALERTS";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">
    <section class="inv-section">

        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-exclamation-triangle-fill"></i> Active Alerts
            </h2>
            <a asp-action="History" class="inv-btn inv-btn-outline">
                <i class="bi bi-clock-history"></i> View History
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            @await Html.PartialAsync("_EmptyState",
                ("bi-check-circle", "All clear — no active alerts", "All inventory levels are above their thresholds."))
        }
        else
        {
            @await Html.PartialAsync("_SearchBar", new ViewDataDictionary(ViewData) {
                { "InputId",     "alertSearch"      },
                { "ClearId",     "alertSearchClear" },
                { "Placeholder", "Search by product or severity..." }
            })

            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Current Stock</th>
                        <th>Threshold</th>
                        <th>Severity</th>
                        <th>Triggered</th>
                        <th class="center">Actions</th>
                    </tr>
                </thead>
                <tbody id="alertsTbody">
                    @foreach (var alert in Model)
                    {
                        <tr>
                            <td data-label="Product"><strong>@alert.ProductName</strong></td>
                            <td data-label="Current Stock">
                                <span class="inv-badge @(alert.CurrentStock == 0 ? "inv-badge-danger" : "inv-badge-warning")">
                                    @alert.CurrentStock
                                </span>
                            </td>
                            <td data-label="Threshold" class="inv-cell-muted">@alert.Threshold</td>
                            <td data-label="Severity">
                                <span class="@(alert.Severity == "Critical" ? "sa-badge-critical" : "sa-badge-warning")">
                                    <i class="bi bi-exclamation-circle"></i> @alert.Severity
                                </span>
                            </td>
                            <td data-label="Triggered" class="inv-cell-muted">
                                @alert.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td data-label="Actions" class="center">
                                <div class="inv-actions">
                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@alert.ProductId"
                                       class="inv-btn inv-btn-info inv-btn-sm" title="Restock product">
                                        <i class="bi bi-box-arrow-in-up"></i> Restock
                                    </a>
                                    <button onclick="resolveAlertPage(@alert.Id, this)"
                                            class="inv-btn inv-btn-success inv-btn-sm" title="Mark resolved">
                                        <i class="bi bi-check-lg"></i> Resolve
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

    </section>
</div>

@section Scripts {
    <script src="/js/search.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            StockAlertService.initPage();
            TableSearchService.init({
                inputId:       'alertSearch',
                clearBtnId:    'alertSearchClear',
                tbodyId:       'alertsTbody',
                columnIndexes: [0, 3]
            });
        });
    </script>
}
