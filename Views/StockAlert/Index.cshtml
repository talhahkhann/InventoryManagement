@model List<InventoryManagement.ViewModels.StockAlertViewModel>
@{
    ViewData["Title"] = "Stock Alerts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-exclamation-triangle-fill text-warning"></i> Active Stock Alerts</h2>
        <a href="@Url.Action("History", "StockAlert")" class="btn btn-outline-secondary">
            <i class="bi bi-clock-history"></i> View History
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle"></i> No active stock alerts. All inventory levels are healthy!
        </div>
    }
    else
    {
        @await Html.PartialAsync("_SearchBar", new ViewDataDictionary(ViewData) {
            { "InputId",     "alertSearch"      },
            { "ClearId",     "alertSearchClear" },
            { "Placeholder", "Search by product, severity..." }
        })

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th>Current Stock</th>
                        <th>Threshold</th>
                        <th>Severity</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="alertsTbody">
                    @foreach (var alert in Model)
                    {
                        <tr class="@(alert.Severity == "Critical" ? "table-danger" : "table-warning")">
                            <td><strong>@alert.ProductName</strong></td>
                            <td>
                                <span class="badge @(alert.CurrentStock == 0 ? "bg-danger" : "bg-warning text-dark")">
                                    @alert.CurrentStock
                                </span>
                            </td>
                            <td>@alert.Threshold</td>
                            <td>
                                <span class="badge @(alert.Severity == "Critical" ? "bg-danger" : "bg-warning text-dark")">
                                    <i class="bi bi-exclamation-circle"></i> @alert.Severity
                                </span>
                            </td>
                            <td>@alert.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Edit", "Products", new { id = alert.ProductId })" 
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-box-arrow-in-up"></i> Restock
                                </a>
                                <button onclick="resolveAlertPage(@alert.Id, this)" 
                                        class="btn btn-sm btn-success">
                                    <i class="bi bi-check-lg"></i> Resolve
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="/js/stockalert.js"></script>
    <script src="/js/search.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            TableSearchService.init({
                inputId:       'alertSearch',
                clearBtnId:    'alertSearchClear',
                tbodyId:       'alertsTbody',
                columnIndexes: [0, 3]   // Product, Severity
            });
        });
    </script>
}
