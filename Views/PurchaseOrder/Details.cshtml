@model InventoryManagement.ViewModels.PurchaseOrderDetailsViewModel
@using InventoryManagement.Models

@{
    ViewData["Title"]       = $"PO #{Model.Id}";
    ViewData["HeaderIcon"]  = "bi-box-arrow-in-down";
    ViewData["HeaderTitle"] = $"PURCHASE ORDER #{Model.Id}";
    Layout = "~/Views/Shared/_InventoryLayout.cshtml";
}

<div class="inv-content">

    @if (TempData["Success"] is string ok)
    {
        <div class="inv-alert inv-alert-success"><i class="bi bi-check-circle-fill"></i> @ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="inv-alert inv-alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @err</div>
    }

    @* ── Header card ── *@
    <section class="inv-section">
        <div class="inv-section-header">
            <h2 class="inv-section-title">
                <i class="bi bi-info-circle"></i> Order Summary
            </h2>

            @* Status badge *@
            @{
                var (badgeClass, badgeIcon, badgeLabel) = Model.Status switch {
                    PurchaseOrderStatus.Received  => ("inv-badge inv-badge-success", "bi-check-circle-fill", "Received"),
                    PurchaseOrderStatus.Cancelled => ("inv-badge inv-badge-muted",   "bi-x-circle",          "Cancelled"),
                    _                             => ("inv-badge inv-badge-warning", "bi-hourglass-split",   "Draft — Pending Receipt")
                };
            }
            <span class="@badgeClass" style="font-size:.9rem;padding:6px 14px;">
                <i class="bi @badgeIcon"></i> @badgeLabel
            </span>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px 24px;">
            <div>
                <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#718096;margin-bottom:4px;">Supplier</div>
                <div style="font-weight:700;color:#2d3748;">@Model.SupplierName</div>
                @if (!string.IsNullOrEmpty(Model.SupplierPhone))
                {
                    <div style="font-size:.82rem;color:#718096;">@Model.SupplierPhone</div>
                }
            </div>
            <div>
                <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#718096;margin-bottom:4px;">Order Date</div>
                <div style="font-weight:600;color:#2d3748;">@Model.OrderDate.ToString("MMM dd, yyyy")</div>
            </div>
            @if (Model.ReceivedDate.HasValue)
            {
                <div>
                    <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#718096;margin-bottom:4px;">Received Date</div>
                    <div style="font-weight:600;color:#2d3748;">@Model.ReceivedDate.Value.ToString("MMM dd, yyyy")</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.ReceivedBy))
            {
                <div>
                    <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#718096;margin-bottom:4px;">Received By</div>
                    <div style="font-weight:600;color:#2d3748;">@Model.ReceivedBy</div>
                </div>
            }
            <div>
                <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#718096;margin-bottom:4px;">Total Cost</div>
                <div style="font-weight:800;color:#38a169;font-size:1.15rem;">PKR @Model.TotalCost.ToString("N2")</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="margin-top:16px;padding:12px 16px;background:#f7fafc;border-radius:8px;border:1px solid #e2e8f0;">
                <span style="font-size:.78rem;font-weight:700;color:#718096;text-transform:uppercase;">Notes: </span>
                <span style="color:#4a5568;">@Model.Notes</span>
            </div>
        }
    </section>

    @* ── Line items ── *@
    <section class="inv-section">
        <div class="inv-section-header">
            <h2 class="inv-section-title"><i class="bi bi-list-ul"></i> Order Items</h2>
        </div>

        <table class="inv-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Product</th>
                    <th style="width:120px;">Qty Ordered</th>
                    <th style="width:150px;">Unit Cost</th>
                    <th style="width:150px;">Line Total</th>
                </tr>
            </thead>
            <tbody>
                @{ int row = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@(row++)</td>
                        <td><strong>@item.ProductName</strong></td>
                        <td class="inv-cell-qty">@item.Quantity</td>
                        <td class="inv-cell-price">PKR @item.UnitCost.ToString("N2")</td>
                        <td class="inv-cell-price">PKR @item.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" style="text-align:right;font-weight:700;padding:14px 14px;border-top:2px solid #e2e8f0;">
                        GRAND TOTAL
                    </td>
                    <td style="padding:14px 14px;border-top:2px solid #e2e8f0;">
                        <span style="font-size:1.2rem;font-weight:800;color:#38a169;">
                            PKR @Model.TotalCost.ToString("N2")
                        </span>
                    </td>
                </tr>
            </tfoot>
        </table>
    </section>

    @* ── Actions ── *@
    <div class="inv-form-footer" style="margin-top:0;">
        <a asp-action="Index" class="inv-btn inv-btn-outline">
            <i class="bi bi-arrow-left-circle"></i> Back to List
        </a>

        @if (Model.Status == PurchaseOrderStatus.Draft)
        {
            <form asp-action="Receive" asp-route-id="@Model.Id" method="post" style="display:inline;"
                  onsubmit="return confirm('Mark PO #@Model.Id as Received? This will add stock to inventory and cannot be undone.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="inv-btn inv-btn-success" style="background:#38a169;">
                    <i class="bi bi-box-arrow-in-down"></i> Receive Stock
                </button>
            </form>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;"
                  onsubmit="return confirm('Delete Draft PO #@Model.Id?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="inv-btn inv-btn-danger">
                    <i class="bi bi-trash"></i> Delete Draft
                </button>
            </form>
        }
    </div>

</div>
